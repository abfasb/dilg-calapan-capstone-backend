{
  "compilerOptions": {
    "target": "ES2020",                          
    "module": "CommonJS",                        
    "rootDir": "src",                            
    "outDir": "dist",                            
    "strict": true,                              
    "esModuleInterop": true,                     
    "forceConsistentCasingInFileNames": true,    
    "skipLibCheck": true,                        
    "resolveJsonModule": true,                   
    "types": ["node", "express", "mongoose"],    
    "allowSyntheticDefaultImports": true,        
    "moduleResolution": "node",                  
    "noImplicitAny": false,                      
    "sourceMap": true,                           
    "baseUrl": "./"                              
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
